msgid "WPForms Database Manager"
msgstr "WPForms 数据库管理器"

msgid ""
"Store and manage WPForms submissions securely inside your WordPress dashboard. "
"Enable database storage to keep a backup of all form entries."
msgstr ""
"在 WordPress 控制面板中安全地存储和管理 WPForms 提交内容。启用数据库存储可保留所有"
"表单条目的备份。"

msgid "Enable Database Storage"
msgstr "启用数据库存储"

msgid "Automatically save all form submissions to your WordPress database."
msgstr "自动将所有表单提交保存到你的 WordPress 数据库。"

msgid "Data Management Guidelines"
msgstr "数据管理指南"

msgid "Enable storage before launching live forms"
msgstr "在启用正式表单之前先启用存储"

msgid "Regularly remove spam entries to maintain performance"
msgstr "定期删除垃圾条目以保持性能"

msgid "Delete unused form data to reduce database load"
msgstr "删除未使用的表单数据以减轻数据库负载"

msgid "Save Settings"
msgstr "保存设置"

msgid "Back to Forms"
msgstr "返回表单"

msgid "Want to send entries to Google Sheets?"
msgstr "想将条目发送到 Google Sheets？"

msgid ""
"Export and sync your form submissions directly to Google Sheets to easily "
"organize, filter, and manage your data in one place. Unlock this feature to "
"simplify your workflow and access your entries anytime."
msgstr ""
"将您的表单提交内容导出并直接同步到 Google Sheets，轻松在一个地方整理、筛选和管理数"
"据。解锁此功能，让您的工作流程更简单，并随时访问您的条目。"

msgid "Upgrade to Unlock"
msgstr "升级以解锁"

msgid "Want to download your form entries?"
msgstr "想下载您的表单条目？"

msgid ""
"Export your form entries as a CSV file and use them in Sheets. You can sort, "
"filter, and manage everything more easily."
msgstr ""
"将您的表单条目导出为 CSV 文件，并在 Sheets 中使用。您可以更轻松地排序、筛选和管理"
"所有内容。"

msgid "Back to Entries"
msgstr "返回条目"

msgid "Entry not found."
msgstr "未找到条目。"

msgid "Fields"
msgstr "字段"

msgid "Entry Details"
msgstr "条目详情"

msgid "Entry ID"
msgstr "条目 ID"

msgid "Submitted On"
msgstr "提交时间"

msgid "User Email"
msgstr "用户邮箱"

msgid "Remote IP"
msgstr "远程 IP"

msgid "User Agent"
msgstr "用户代理"

msgid "WPForms List"
msgstr "WPForms 列表"

msgid ""
"View all WPForms that are currently saving submissions to the database. Select a "
"form below to access and manage its stored entries."
msgstr ""
"查看当前正在将提交内容保存到数据库中的所有 WPForms。请在下方选择一个表单，以访问和"
"管理其已存储的条目。"

msgid "Send To SpreadSheet"
msgstr "发送到电子表格"

msgid "Delete"
msgstr "删除"

msgid "Mark Read"
msgstr "标记为已读"

msgid "Mark Unread"
msgstr "标记为未读"

msgid "Send to Sheet"
msgstr "发送到表格"

msgid "Google Sheet Settings"
msgstr "Google 表格设置"

msgid "Google Sheet Name"
msgstr "Google 表格名称"

msgid ""
"Go to your google account and click on \"Google apps\" icon and then click "
"\"Sheets\". Select the name of the appropriate sheet you want to link your "
"contact form or create a new sheet."
msgstr ""
"请进入您的 Google 账户，点击“Google 应用”图标，然后点击“Sheets”。选择您要链接的联"
"系表单对应的表格名称，或者创建一个新表格。"

msgid "Google Sheet Id"
msgstr "Google 表格 ID"

msgid "You can get sheet ID from your sheet URL."
msgstr "您可以从表格 URL 中获取表格 ID。"

msgid "Google Sheet Tab Name"
msgstr "Google Sheet 标签名称"

msgid ""
"Open your Google Sheet you want to link with your contact form. You will notice "
"tab names at the bottom. Copy the name of the tab where you want entries."
msgstr ""
"打开你想与联系表单关联的 Google Sheet。你会注意到底部有标签名称。复制你希望保存条"
"目的标签名称。"

msgid "Google Tab Id"
msgstr "Google 标签 ID"

msgid "You can get the tab ID from your Google Sheet URL."
msgstr "你可以从 Google Sheet 的 URL 中获取标签 ID。"

msgid "Google Sheet Link"
msgstr "Google Sheet 链接"

msgid "Upgrade to WPForms Google sheet Connector PRO"
msgstr "升级到 WPForms Google sheet Connector PRO"

msgid "Click Here Demo"
msgstr "点击此处查看演示"

msgid "Sheet URL (Click Here to view Sheet with submitted data.)"
msgstr "Sheet URL（点击此处查看包含提交数据的 Sheet。）"

msgid "WPForms Google Sheet Connector PRO Features"
msgstr "WPForms Google Sheet Connector PRO 功能"

msgid "Google Sheets API (Up-to date)"
msgstr "Google Sheets API（最新）"

msgid "One Click Authentication"
msgstr "一键认证"

msgid "Click & Fetch Sheet Automated"
msgstr "点击并自动获取 Sheet"

msgid "Automated Sheet Name & Tab Name"
msgstr "自动化 Sheet 名称和标签名称"

msgid "Manually Adding Sheet Name & Tab Name"
msgstr "手动添加 Sheet 名称和标签名称"

msgid "Supported WPForms Lite/Pro"
msgstr "支持 WPForms Lite/Pro"

msgid "Latest WordPress & PHP Support"
msgstr "支持最新 WordPress 和 PHP"

msgid "Support WordPress Multisite"
msgstr "支持 WordPress 多站点"

msgid "Multiple Forms to Sheet"
msgstr "多个表单同步到 Sheet"

msgid "Roles Management"
msgstr "角色管理"

msgid "Creating New Sheet Option"
msgstr "创建新 Sheet 选项"

msgid "Authenticated Email Display"
msgstr "已认证邮箱显示"

msgid "Automatic Updates"
msgstr "自动更新"

msgid "Using Smart Tags"
msgstr "使用 Smart Tags"

msgid "Custom Ordering"
msgstr "自定义排序"

msgid "Image / PDF Attachment Link"
msgstr "图片 / PDF 附件链接"

msgid "Sheet Headers Settings"
msgstr "Sheet 表头设置"

msgid "Click to Sync"
msgstr "点击同步"

msgid "Sheet Sorting"
msgstr "Sheet 排序"

msgid "Excellent Priority Support"
msgstr "优先级技术支持"

msgid "Buy Now"
msgstr "立即购买"

msgid "Google Sheets Integration for WPForms"
msgstr "WPForms 的 Google Sheets 集成"

msgid "Choose Google API Setting"
msgstr "选择 Google API 设置"

msgid "Existing Client / Secret Key (Auto Setup)"
msgstr "现有客户端 / 密钥（自动设置）"

msgid "Manual Client/Secret Key (Use Your Google API Configuration)"
msgstr "手动客户端/密钥（使用您的 Google API 配置）"

msgid "Service Account (Recommended)"
msgstr "服务账号（推荐）"

msgid "Select how WPForms should authenticate with Google Sheets."
msgstr "选择 WPForms 应如何与 Google Sheets 进行身份验证。"

msgid "Save"
msgstr "保存"

msgid "Google Account Connection"
msgstr "Google 账号连接"

msgid "Auto Setup"
msgstr "自动设置"

msgid ""
"Sign in with your Google account to connect WPForms with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the documentation"
msgstr ""
"使用您的 Google 账号登录，将 WPForms 连接到 Google Sheets。连接后，您的数据将根据"
"设置进行同步。了解更多，请参阅文档"

msgid "click here"
msgstr "点击这里"

msgid "Authenticate with Your Google Account"
msgstr "使用您的 Google 账号进行身份验证"

msgid "Click on the"
msgstr "点击"

msgid "Sign in with Google"
msgstr "使用 Google 登录"

msgid " button."
msgstr " 按钮。"

msgid "Log in using your Google account."
msgstr "使用您的 Google 账号登录。"

msgid "Select the Google account where your Sheets are stored."
msgstr "选择存储您的 Sheets 的 Google 账号。"

msgid "Grant access to:"
msgstr "授予以下访问权限："

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Sheets"
msgstr "Google Sheets"

msgid "Click"
msgstr "点击"

msgid "Allow to finish authorization."
msgstr "允许以完成授权。"

msgid "to finish authorization."
msgstr "以完成授权。"

msgid "Save the authentication code if prompted."
msgstr "如提示，请保存身份验证代码。"

msgid "This allows the plugin to securely sync your form data with Google Sheets."
msgstr "这可让插件安全地将您的表单数据同步到 Google Sheets。"

msgid ""
"Google Drive and Google Sheets permissions were not granted during authentication "
"with Google."
msgstr "在使用 Google 进行身份验证时，未授予 Google Drive 和 Google Sheets 权限。"

msgid "Refer to Step 4 in the Connection Guide shown alongside."
msgstr "请参考旁边连接指南中的第 4 步。"

msgid ""
"Then, deactivate the connection and re-authorize it, ensuring both Google Drive "
"and Google Sheets permissions are enabled."
msgstr "然后，停用连接并重新授权，确保已启用 Google Drive 和 Google Sheets 权限。"

msgid "and"
msgstr "和"

msgid ""
"Something went wrong! Your auth code may be wrong or expired. Please deactivate "
"auth and re-authenticate again."
msgstr "出错了！您的授权代码可能有误或已过期。请停用授权并重新进行身份验证。"

msgid "Connected Google Account"
msgstr "已连接的 Google 账户"

msgid "Client Token"
msgstr "客户端令牌"

msgid "Connect Your Google Account"
msgstr "连接您的 Google 账户"

msgid ""
"Securely link your Google account to start syncing form entries automatically."
msgstr "安全地将您的 Google 账户连接起来，开始自动同步表单条目。"

msgid "Connected"
msgstr "已连接"

msgid "Click Sign in with Google"
msgstr "点击使用 Google 登录"

msgid "Deactivate"
msgstr "停用"

msgid "Deactivate Integration"
msgstr "停用集成"

msgid ""
"Are you sure you want to deactivate Google Sheets integration? This will stop "
"syncing your form entries."
msgstr "您确定要停用 Google Sheets 集成吗？这将停止同步您的表单条目。"

msgid "Cancel"
msgstr "取消"

msgid "Save Client Token"
msgstr "保存客户端令牌"

msgid ""
"We do not store any of the data from your Google account on our servers, "
"everything is processed & stored on your server. We take your privacy extremely "
"seriously and ensure it is never misused. Learn more in the documentation"
msgstr ""
"我们不会在服务器上存储您 Google 账户中的任何数据，所有内容都在您的服务器上处理和存"
"储。我们非常重视您的隐私，并确保其绝不会被滥用。了解更多请参阅文档"

msgid "click here."
msgstr "点击这里。"

msgid "Connection Status & Next Steps"
msgstr "连接状态和下一步"

msgid ""
"Your Google account has been successfully connected. You are now ready to sync "
"your form submissions with Google Sheets securely and automatically."
msgstr ""
"您的 Google 账户已成功连接。您现在可以安全且自动地将表单提交同步到 Google Sheets。"

msgid "Create New Feed"
msgstr "创建新 Feed"

msgid "Select Google Spreadsheet"
msgstr "选择 Google 电子表格"

msgid "Add Labels in Sheet Headers Manually"
msgstr "手动在表格标题中添加标签"

msgid "Enable Fields to Sync"
msgstr "启用要同步的字段"

msgid "Customize the Headers Appearance"
msgstr "自定义标题外观"

msgid "Use Sync Settings (Past Entries)"
msgstr "使用同步设置（历史条目）"

msgid "PRO"
msgstr "PRO"

msgid "Upgrade to unlock"
msgstr "升级以解锁"

msgid "Connection Guide"
msgstr "连接指南"

msgid "Step-by-Step"
msgstr "分步说明"

msgid ""
"Follow these steps to connect your Google account and start syncing your form "
"data with Google Sheets."
msgstr "按照以下步骤连接您的 Google 账户，并开始将表单数据同步到 Google Sheets。"

msgid "Step-1 Connect Your Google Account"
msgstr "步骤 1：连接您的 Google 账户"

msgid ""
"Sign in with your Google account to start the automatic Google Sheets integration."
msgstr "使用您的 Google 账户登录，开始自动 Google Sheets 集成。"

msgid "Step-2 Choose Google Account"
msgstr "步骤 2：选择 Google 账户"

msgid "Choose the Google account where your Sheets are stored."
msgstr "选择存放您的 Sheets 的 Google 账户。"

msgid "check our detailed guideline"
msgstr "查看我们的详细指南"

msgid "Step-3 Review Access Information"
msgstr "步骤 3：查看访问信息"

msgid "Google will show what information the plugin can access."
msgstr "Google 将显示插件可以访问哪些信息。"

msgid "Step-4 Grant Required Permissions"
msgstr "步骤 4：授予所需权限"

msgid "Allow required permissions for Google Sheets and Drive access."
msgstr "允许 Google Sheets 和 Drive 访问所需的权限。"

msgid "Step-5 Save Authentication Code"
msgstr "步骤 5：保存身份验证码"

msgid "Save the authentication code to complete the Google account connection."
msgstr "保存身份验证码以完成 Google 账户连接。"

msgid "Step-6 Integration Completed"
msgstr "步骤 6：集成已完成"

msgid "Your Google account is now successfully connected."
msgstr "您的 Google 账户现已成功连接。"

msgid "Manual Google Sheets Integration"
msgstr "手动 Google Sheets 集成"

msgid ""
"Connect WP Forms to Google Sheets using your own Google Cloud project. Ideal for "
"advanced users who need full API control, custom OAuth setup, and independent "
"credential management."
msgstr ""
"使用您自己的 Google Cloud 项目将 WP Forms 连接到 Google Sheets。非常适合需要完整 "
"API 控制、自定义 OAuth 设置和独立凭据管理的高级用户。"

msgid "Custom API Credentials"
msgstr "自定义 API 凭据"

msgid ""
"Connect using your own Google Cloud Client ID and Client Secret for full "
"authentication control."
msgstr ""
"使用您自己的 Google Cloud Client ID 和 Client Secret 进行连接，以实现完整的身份验"
"证控制。"

msgid "Secure Authentication"
msgstr "安全身份验证"

msgid ""
"Authenticate directly with Google using a secure Authentication flow without "
"third-party dependency."
msgstr "通过安全的身份验证流程直接使用 Google 进行身份验证，无需依赖第三方。"

msgid "Advanced Configuration"
msgstr "高级配置"

msgid ""
"Set custom Redirect URIs, manage scopes, and configure API settings based on your "
"project needs."
msgstr "根据您的项目需求设置自定义重定向 URI、管理作用域并配置 API 设置。"

msgid "Priority Technical Support"
msgstr "优先技术支持"

msgid ""
"Get fast assistance from our expert team for setup, troubleshooting, and "
"optimization."
msgstr "从我们的专家团队获得有关设置、故障排除和优化的快速帮助。"

msgid "View Pro Features"
msgstr "查看 Pro 功能"

msgid "WPForms - Google Sheet Settings"
msgstr "WPForms - Google Sheet 设置"

msgid "Select a form to configure the WPForms GSheetConnector integration."
msgstr "选择一个表单以配置 WPForms GSheetConnector 集成。"

msgid "Choose WPForms"
msgstr "选择 WPForms"

msgid "Select Form"
msgstr "选择表单"

msgid "Invalid access code entered."
msgstr "输入的访问代码无效。"

msgid "Your Google Access Code is Authorized and Saved"
msgstr "您的 Google 访问代码已授权并已保存"

msgid "Unauthorized access."
msgstr "未授权访问。"

msgid "Invalid authentication method."
msgstr "无效的身份验证方法。"

msgid "Authentication method saved successfully."
msgstr "身份验证方法保存成功。"

msgid "Something went wrong. Please try again."
msgstr "发生了错误。请重试。"

msgid "JSON data is empty. Please provide valid credentials."
msgstr "JSON 数据为空。请提供有效的凭据。"

msgid "Your uploaded JSON key is invalid"
msgstr "您上传的 JSON 密钥无效"

msgid "Service account credentials saved successfully."
msgstr "服务账号凭据已成功保存。"

msgid "Service account deactivated successfully."
msgstr "服务账号已成功停用。"

msgid "Not connected"
msgstr "未连接"

msgid "No WPForms are connected with Google Sheets"
msgstr "没有与 Google Sheets 连接的 WPForms"

msgid "Create Feed"
msgstr "创建 Feed"

msgid "Please rate"
msgstr "请评分"

msgid "GSheetConnector for WPForms"
msgstr "GSheetConnector for WPForms"

msgid "on"
msgstr "在"

msgid "WordPress.org"
msgstr "WordPress.org"

msgid "to help us spread the word."
msgstr "以帮助我们传播这个消息。"

msgid "Version:"
msgstr "版本："

msgid "Plugins"
msgstr "插件"

msgid "About GSheetConnector"
msgstr "关于 GSheetConnector"

msgid "Built by Experts. Trusted by Thousands."
msgstr "由专家打造。深受数千用户信赖。"

msgid ""
"Led by experienced developers and powered by a passionate team, GSheetConnector "
"helps WordPress users automate their workflows with confidence."
msgstr ""
"在经验丰富的开发者带领下，由充满热情的团队支持，GSheetConnector 帮助 WordPress 用"
"户自信地自动化工作流程。"

msgid ""
"We focus on building tools that are fast, secure, and easy to use - so you can "
"spend less time managing data."
msgstr "我们专注于构建快速、安全且易于使用的工具——让您花更少时间管理数据。"

msgid "Meet Our Core Team"
msgstr "认识我们的核心团队"

msgid "Our Mission"
msgstr "我们的使命"

msgid ""
"Our mission is to make form automation simple, secure, and reliable for every "
"WordPress user - from beginners to enterprise teams."
msgstr ""
"我们的使命是让每一位 WordPress 用户——从初学者到企业团队——都能轻松、安全、可靠地实"
"现表单自动化。"

msgid "Fast & Reliable Data Sync"
msgstr "快速且可靠的数据同步"

msgid "100% Secure Authentication"
msgstr "100% 安全认证"

msgid "Real-Time Google Sheets Updates"
msgstr "实时 Google Sheets 更新"

msgid "Easy Setup & Configuration"
msgstr "轻松设置与配置"

msgid "Dedicated Support Team"
msgstr "专属支持团队"

msgid "Forms Successfully Synced"
msgstr "表单已成功同步"

msgid "Trusted by Active Users"
msgstr "深受活跃用户信赖"

msgid "Reliable Uptime"
msgstr "稳定可靠的在线运行时间"

msgid "Dedicated Support"
msgstr "专属支持"

msgid "Add-ons & Extensions"
msgstr "附加组件与扩展"

msgid ""
"Extend your Google Sheets integration with powerful add-ons. Install, manage, and "
"activate extensions to unlock advanced features."
msgstr ""
"使用强大的附加组件扩展您的 Google Sheets 集成。安装、管理并激活扩展以解锁高级功"
"能。"

msgid "CF7 Google Sheet Connector"
msgstr "CF7 Google Sheet Connector"

msgid ""
"Easily connect Contact Form 7 to Google Sheets and automatically sync form "
"submissions in real-time. Every entry is instantly added to your selected "
"spreadsheet, helping you manage leads, inquiries, and customer data efficiently "
"without manual export."
msgstr ""
"轻松将 Contact Form 7 连接到 Google Sheets，并实时自动同步表单提交。每条记录都会立"
"即添加到您选定的电子表格中，帮助您高效管理潜在客户、咨询和客户数据，无需手动导出。"

msgid "Install"
msgstr "安装"

msgid "WPForms Google Sheet Connector"
msgstr "WPForms Google Sheet Connector"

msgid ""
"Integrate WPForms with Google Sheets and send form entries directly to your "
"spreadsheet automatically. Track leads, manage customer data, and streamline "
"reporting with seamless Google Sheets integration and real-time sync."
msgstr ""
"将 WPForms 与 Google Sheets 集成，并自动将表单条目直接发送到您的电子表格。通过无缝"
"的 Google Sheets 集成和实时同步，跟踪潜在客户、管理客户数据并简化报告。"

msgid "Gravity Forms Google Sheet Connector"
msgstr "Gravity Forms Google Sheet Connector"

msgid ""
"Connect Gravity Forms to Google Sheets and automatically push form submissions to "
"your spreadsheet. Simplify data management, improve workflow automation, and keep "
"all entries organized in one secure location."
msgstr ""
"将 Gravity Forms 连接到 Google Sheets，并自动将表单提交推送到您的电子表格。简化数"
"据管理，提升工作流程自动化，并将所有条目集中保存在一个安全位置。"

msgid "Ninja Forms Google Sheet Connector"
msgstr "Ninja Forms Google Sheet Connector"

msgid ""
"Automatically sync Ninja Forms submissions to Google Sheets with one-click "
"integration. Capture leads, monitor responses, and manage data efficiently with "
"instant spreadsheet updates and easy reporting."
msgstr ""
"通过一键集成，自动将 Ninja Forms 提交同步到 Google Sheets。借助即时电子表格更新和"
"便捷报告，高效捕获潜在客户、监控回复并管理数据。"

msgid "Forminator Forms Google Sheet Connector"
msgstr "Forminator Forms Google Sheet Connector"

msgid ""
"Integrate Forminator Forms with Google Sheets to automatically store form entries "
"in your spreadsheet. Eliminate manual data entry and ensure accurate, real-time "
"syncing for better data tracking and analysis."
msgstr ""
"将 Forminator Forms 与 Google Sheets 集成，自动将表单条目存储到您的电子表格中。消"
"除手动录入，确保准确的实时同步，以便更好地跟踪和分析数据。"

msgid "Free"
msgstr "免费"

msgid "Formidable Forms Google Sheet Connector"
msgstr "Formidable Forms Google Sheet Connector"

msgid ""
"Automatically sync Formidable Forms entries to Google Sheets. Manage leads, track "
"submissions, and simplify data reporting with real-time integration."
msgstr ""
"自动将 Formidable Forms 条目同步到 Google Sheets。通过实时集成管理潜在客户、跟踪提"
"交并简化数据报告。"

msgid "Fluent Forms Google Sheet Connector"
msgstr "Fluent Forms Google Sheet Connector"

msgid ""
"Automatically sync Fluent Forms submissions to Google Sheets in real-time. Every "
"form entry is instantly added to your selected spreadsheet, helping you manage "
"leads, customer inquiries, and business data without manual export. Streamline "
"your workflow, improve reporting accuracy, and keep all submissions organized "
