msgstr "E-mailadres gebruiker"

msgid "Remote IP"
msgstr "Extern IP-adres"

msgid "User Agent"
msgstr "Gebruikersagent"

msgid "WPForms List"
msgstr "WPForms-lijst"

msgid ""
"View all WPForms that are currently saving submissions to the database. Select a "
"form below to access and manage its stored entries."
msgstr ""
"Bekijk alle WPForms die momenteel inzendingen opslaan in de database. Selecteer "
"hieronder een formulier om de opgeslagen inzendingen te openen en te beheren."

msgid "Send To SpreadSheet"
msgstr "Verstuur naar Spreadsheet"

msgid "Delete"
msgstr "Verwijderen"

msgid "Mark Read"
msgstr "Markeren als gelezen"

msgid "Mark Unread"
msgstr "Markeren als ongelezen"

msgid "Google Sheet Settings"
msgstr "Google Sheet Instellingen"

msgid "Google Sheet Name"
msgstr "Google Sheet Naam"

msgid ""
"Go to your google account and click on \"Google apps\" icon and then click "
"\"Sheets\". Select the name of the appropriate sheet you want to link your "
"contact form or create a new sheet."
msgstr ""
"Ga naar uw Google-account en klik op het pictogram 'Google-apps' en klik "
"vervolgens op 'Sheets'. Selecteer de naam van het juiste blad dat u wilt koppelen "
"aan uw contactformulier of maak een nieuw blad aan."

msgid "Google Sheet Id"
msgstr "Google Sheet Id"

msgid "You can get sheet ID from your sheet URL."
msgstr "U kunt de sheet-ID uit de URL van uw sheet halen."

msgid "Google Sheet Tab Name"
msgstr "Google Sheet Tab Naam"

msgid ""
"Open your Google Sheet you want to link with your contact form. You will notice "
"tab names at the bottom. Copy the name of the tab where you want entries."
msgstr ""
"Open uw Google Sheet die u wilt koppelen aan uw contactformulier. U ziet onderaan "
"tabbladnamen. Kopieer de naam van het tabblad waar u invoer wilt hebben."

msgid "Google Tab Id"
msgstr "Google-tab-ID"

msgid "You can get the tab ID from your Google Sheet URL."
msgstr "U kunt de tab-ID uit uw Google Sheet-URL halen."

msgid "Google Sheet Link"
msgstr "Google Sheet-koppeling"

msgid "Upgrade to WPForms Google sheet Connector PRO"
msgstr "Upgrade naar WPForms Google sheet Connector PRO"

msgid "Click Here Demo"
msgstr "Klik Hier Demo"

msgid "Sheet URL (Click Here to view Sheet with submitted data.)"
msgstr "Sheet URL (Klik Hier om Sheet met ingediende gegevens te bekijken.)"

