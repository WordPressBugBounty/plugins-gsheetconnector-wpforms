msgstr "用户邮箱"

msgid "Remote IP"
msgstr "远程 IP"

msgid "User Agent"
msgstr "用户代理"

msgid "WPForms List"
msgstr "WPForms 列表"

msgid ""
"View all WPForms that are currently saving submissions to the database. Select a "
"form below to access and manage its stored entries."
msgstr ""
"查看当前正在将提交内容保存到数据库中的所有 WPForms。请在下方选择一个表单，以访问和"
"管理其已存储的条目。"

msgid "Send To SpreadSheet"
msgstr "发送到电子表格"

msgid "Delete"
msgstr "删除"

msgid "Mark Read"
msgstr "标记为已读"

msgid "Mark Unread"
msgstr "标记为未读"

