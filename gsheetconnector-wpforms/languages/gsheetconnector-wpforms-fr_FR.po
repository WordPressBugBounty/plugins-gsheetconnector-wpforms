msgid "WPForms Database Manager"
msgstr "Gestionnaire de base de données WPForms"

msgid ""
"Store and manage WPForms submissions securely inside your WordPress dashboard. "
"Enable database storage to keep a backup of all form entries."
msgstr ""
"Stockez et gérez les soumissions WPForms en toute sécurité dans votre tableau de "
"bord WordPress. Activez le stockage en base de données pour conserver une "
"sauvegarde de toutes les entrées de formulaire."

msgid "Enable Database Storage"
msgstr "Activer le stockage dans la base de données"

msgid "Automatically save all form submissions to your WordPress database."
msgstr ""
"Enregistrez automatiquement toutes les soumissions de formulaires dans votre base "
"de données WordPress."

