msgid "WPForms Database Manager"
msgstr "WPForms Database Manager"

msgid ""
"Store and manage WPForms submissions securely inside your WordPress dashboard. "
"Enable database storage to keep a backup of all form entries."
msgstr ""
"Sla WPForms-inzendingen veilig op en beheer ze binnen uw WordPress-dashboard. "
"Schakel database-opslag in om een back-up van alle formulierinzendingen te "
"bewaren."

msgid "Enable Database Storage"
msgstr "Schakel databaseopslag in"

msgid "Automatically save all form submissions to your WordPress database."
msgstr "Sla automatisch alle formulierinzendingen op in uw WordPress-database."

msgid "Data Management Guidelines"
msgstr "Gegevensbeheer richtlijnen"

msgid "Enable storage before launching live forms"
msgstr "Schakel opslag in voordat u live formulieren lanceert"

msgid "Regularly remove spam entries to maintain performance"
msgstr "Verwijder regelmatig spam-inzendingen om de prestaties te behouden"

msgid "Delete unused form data to reduce database load"
msgstr ""
"Verwijder ongebruikte formuliergegevens om de databasebelasting te verminderen"

msgid "Save Settings"
msgstr "Instellingen Opslaan"

msgid "Back to Forms"
msgstr "Terug naar formulieren"

msgid "Want to send entries to Google Sheets?"
msgstr "Wilt u inzendingen naar Google Sheets sturen?"

msgid ""
"Export and sync your form submissions directly to Google Sheets to easily "
"organize, filter, and manage your data in one place. Unlock this feature to "
"simplify your workflow and access your entries anytime."
msgstr ""
"Exporteer en synchroniseer uw formulierinzendingen rechtstreeks naar Google "
"Sheets om uw gegevens eenvoudig op één plek te ordenen, filteren en beheren. "
"Ontgrendel deze functie om uw workflow te vereenvoudigen en altijd toegang te "
"hebben tot uw inzendingen."

msgid "Upgrade to Unlock"
msgstr "Upgrade om te Ontgrendelen"

msgid "Want to download your form entries?"
msgstr "Wilt u uw formulierinzendingen downloaden?"

msgid ""
"Export your form entries as a CSV file and use them in Sheets. You can sort, "
"filter, and manage everything more easily."
msgstr ""
"Exporteer uw formulierinzendingen als een CSV-bestand en gebruik ze in Sheets. U "
"kunt alles eenvoudiger sorteren, filteren en beheren."

msgid "Back to Entries"
msgstr "Terug naar Inzendingen"

msgid "Entry not found."
msgstr "Inzending niet gevonden."

msgid "Fields"
msgstr "Velden"

msgid "Entry Details"
msgstr "Inzendingsdetails"

msgid "Entry ID"
msgstr "Ingang ID"

msgid "Submitted On"
msgstr "Verzonden op"

