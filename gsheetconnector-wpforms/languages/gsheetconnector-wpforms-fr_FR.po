msgstr "Directives de gestion des données"

msgid "Enable storage before launching live forms"
msgstr "Activer le stockage avant de lancer des formulaires en direct"

msgid "Regularly remove spam entries to maintain performance"
msgstr "Supprimez régulièrement les entrées de spam pour maintenir les performances"

msgid "Delete unused form data to reduce database load"
msgstr ""
"Supprimez les données de formulaire non utilisées pour réduire la charge de la "
"base de données"

