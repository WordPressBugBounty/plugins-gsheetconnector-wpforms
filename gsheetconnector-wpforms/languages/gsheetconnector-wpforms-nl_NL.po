msgstr "Authenticatiemethode succesvol opgeslagen."

msgid "Something went wrong. Please try again."
msgstr "Er is iets misgegaan. Probeer het opnieuw."

msgid "JSON data is empty. Please provide valid credentials."
msgstr "JSON-gegevens zijn leeg. Geef geldige inloggegevens op."

msgid "Your uploaded JSON key is invalid"
msgstr "Uw geüploade JSON-sleutel is ongeldig"

msgid "Service account credentials saved successfully."
msgstr "Serviceaccountgegevens succesvol opgeslagen."

msgid "Service account deactivated successfully."
msgstr "Serviceaccount succesvol gedeactiveerd."

msgid "Not connected"
msgstr "Niet verbonden"

msgid "No Form Feeds Created Yet"
msgstr "Nog geen Form Feeds aangemaakt"

msgid ""
"Connect your form to Google Sheets to automatically sync submissions in real "
"time. Create a feed to start sending data to your spreadsheet."
msgstr ""
"Verbind je formulier met Google Sheets om inzendingen automatisch in real time te "
"synchroniseren. Maak een feed aan om gegevens naar je spreadsheet te verzenden."

msgid "Create Feed"
msgstr "Feed aanmaken"

msgid "Please rate"
msgstr "Beoordeel alstublieft"

